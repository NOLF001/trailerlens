# ── Required ────────────────────────────────────────────────────────────────

# Anthropic API key (https://platform.claude.com). Leave empty to run comment
# analysis with the built-in deterministic mock analyzer.
ANTHROPIC_API_KEY=

# YouTube Data API v3 key (Google Cloud Console → APIs & Services).
# Leave empty to run the whole app in mock mode with synthetic data.
YOUTUBE_API_KEY=

# Google OAuth client (needed only for the channel-owner Analytics mode).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Prisma database URL.
#   Local dev (SQLite):  file:./dev.db
#   PostgreSQL:          postgresql://trailerlens:trailerlens@localhost:5432/trailerlens
DATABASE_URL="file:./dev.db"

# NextAuth. Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Optional ────────────────────────────────────────────────────────────────

# Force mock mode even when API keys are present (useful for demos/tests).
MOCK_MODE=false

# Claude model used for comment analysis. Defaults to claude-opus-5.
# High-volume analyses are expensive on Opus-tier models — see README costs section.
ANTHROPIC_MODEL=claude-opus-5

# Experimental local-only yt-dlp adapter for the public "most replayed" heatmap.
# Never enable this in serverless/production deployments. Read the README first.
ENABLE_EXPERIMENTAL_YTDLP=false
YTDLP_PATH=yt-dlp

# Cookies for age-restricted videos (yt-dlp needs a logged-in session for
# these). Export a Netscape-format cookies.txt from a browser signed into a
# YouTube account (prefer a dedicated/test account, not a personal one).
#   Local dev:   point YTDLP_COOKIES_PATH at the file directly.
#   Production:  base64-encode the file into YTDLP_COOKIES_B64 instead —
#                it's written to a temp file at process start. Takes
#                priority over YTDLP_COOKIES_PATH if both are set.
YTDLP_COOKIES_PATH=
YTDLP_COOKIES_B64=

# Optional FFmpeg binary path for user-uploaded footage frame extraction.
FFMPEG_PATH=ffmpeg
